+/**
+ * The edge labels, each moved the least distance that keeps it off the
+ * labels placed before it and off every node's box. Drawn where the router
+ * put them, two labels on one stretch of line (two edges between the same
+ * nodes, say) were written over each other, letter through letter. A label
+ * with no free spot nearby stays where it was.
+ */
+function spreadLabels(graph: AsciiGraph, labelCanvases: Canvas[]): Canvas[] {
+  const [maxX, maxY] = getCanvasSize(graph.canvas)
+  const taken = new Set<string>()
+  const key = (x: number, y: number) => `${x},${y}`
+
+  for (const node of graph.nodes) {
+    if (!node.drawingCoord || !node.drawing) continue
+    const [w, h] = getCanvasSize(node.drawing)
+    for (let x = node.drawingCoord.x; x <= node.drawingCoord.x + w; x++) {
+      for (let y = node.drawingCoord.y; y <= node.drawingCoord.y + h; y++) taken.add(key(x, y))
+    }
+  }
+
+  return labelCanvases.map(canvas => {
+    const cells: Array<[number, number, string]> = []
+    for (let x = 0; x < canvas.length; x++) {
+      const col = canvas[x]!
+      for (let y = 0; y < col.length; y++) if (col[y] !== ' ') cells.push([x, y, col[y]!])
+    }
+    if (cells.length === 0) return canvas
+
+    const fits = ([dx, dy]: readonly [number, number]) =>
+      cells.every(([x, y]) => x + dx >= 0 && y + dy >= 0 && x + dx <= maxX && y + dy <= maxY && !taken.has(key(x + dx, y + dy)))
+    const [dx, dy] = LABEL_SHIFTS.find(fits) ?? [0, 0]
+
+    // A label's own row is kept whole (spaces between its words included), so
+    // the next one can't thread its letters through it.
+    const rows = new Map<number, [number, number]>()
+    for (const [x, y] of cells) {
+      const span = rows.get(y)
+      rows.set(y, span ? [Math.min(span[0], x), Math.max(span[1], x)] : [x, x])
+    }
+    for (const [y, [x0, x1]] of rows) for (let x = x0 - 1; x <= x1 + 1; x++) taken.add(key(x + dx, y + dy))
+
+    // The label at its spot, the gaps between its words hiding the line under
+    // them, so it reads "save result", not "save─result".
+    const placed = copyCanvas(canvas)
